# Spectra Optics - Backend Environment Configuration

# Option A: Zero-install Local SQLite (Default, no setup needed)
DATABASE_URL=sqlite:///./virtual_tryon.db

# Option B: Local PostgreSQL (via PostgreSQL installer on Windows or Docker)
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/virtual_tryon

# Option C: Cloud Hosted PostgreSQL (Supabase / Neon free cloud tier)
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
